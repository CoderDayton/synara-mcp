# Synara configuration
#
# Everything here is optional — Synara runs fine with no setup at all.
# Copy this file to `.env` and uncomment any line you want to change.
# Your `.env` is private (gitignored); this template is the only one tracked.


# ── Server ────────────────────────────────────────────────────────────────────

# How chatty the logs are.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# SYNARA_LOG_LEVEL=INFO

# How the server talks to its client.
# Most users want stdio (the default). Pick http/sse/streamable-http if
# you're connecting over the network instead of via a local process.
# SYNARA_TRANSPORT=stdio

# Where Synara keeps your saved memories on disk.
# By default they're stored in your user cache folder, so they survive
# restarts without you doing anything:
#   Linux/macOS:  ~/.cache/synara-mcp/synara.db
#   (or wherever XDG_CACHE_HOME points, if you set that)
# Set this to a custom path to keep memories somewhere else, or to
# `:memory:` if you want a fresh, empty store every time you start up.
# SYNARA_DB_PATH=


# ── Embeddings ────────────────────────────────────────────────────────────────
#
# Synara turns text into vectors so it can search your memories by meaning.
# You can either let it run a small model on your own machine (the default,
# no setup needed) or point it at a remote service you already have running.

# Which model to use.
#   • Local mode: a Hugging Face model id. Defaults to a fast, lightweight
#     Jina model that downloads automatically the first time you run.
#   • Remote mode: whatever name the service expects in its requests.
# SYNARA_EMBEDDING_MODEL=jinaai/jina-embeddings-v5-text-nano

# Switch to a remote service by setting this to its base URL.
# Leave it blank to keep using the built-in local model.
# A few that work out of the box:
#   http://localhost:11434     ← Ollama running on your machine
#   http://localhost:8080      ← simplevecdb-server
#   https://api.openai.com     ← OpenAI
# SYNARA_EMBEDDING_URL=

# API key for the remote service, if it needs one (e.g. OpenAI).
# Sent as a Bearer token. Ignored when running locally.
# SYNARA_EMBEDDING_API_KEY=

# How long to wait for the remote service before giving up, in seconds.
# Bump this up if you're on a slow connection. Must be a positive
# number, up to 86400 (24h); anything else is rejected at startup.
# SYNARA_EMBEDDING_TIMEOUT=30

# Pin the output vector width. Locally this maps to `truncate_dim` and
# only works for Matryoshka models (Jina v3/v5, BGE-M3, Nomic).
# Remotely it's sent as `dimensions` (OpenAI text-embedding-3 etc.).
# Leave unset to keep the model's native dimension.
# SYNARA_EMBEDDING_DIM=

# How many texts to encode per chunk locally, or per request remotely.
# Larger batches use more memory but finish faster.
# SYNARA_EMBEDDING_BATCH_SIZE=64

# Token cap for the local model. Lower this to trade context length
# for throughput. The remote backend ignores it — the server decides
# truncation.
# SYNARA_EMBEDDING_MAX_SEQ_LENGTH=

# Allow the local SentenceTransformer to execute model-bundled custom
# code at load time (transformers' trust_remote_code). On by default
# because the default Jina v5 model REQUIRES it.
# SECURITY: this runs ARBITRARY PYTHON shipped with the model repo on
# your machine. Set it to false to harden when running a model that
# does not need custom code. Ignored by the remote backend.
# SYNARA_EMBEDDING_TRUST_REMOTE_CODE=true


# ── Dashboard ─────────────────────────────────────────────────────────────────
#
# An optional web admin console that runs alongside the server (same
# process, same lifecycle) so you can browse memories, inspect the
# successor/plasticity graph, watch live stats, and trigger maintenance.
# Off by default. Requires the optional extra: pip install synara-mcp[dashboard]

# Turn the dashboard on.
# SYNARA_DASHBOARD=false

# Address the dashboard binds to. Defaults to localhost only, which is
# the safe choice — nothing outside your machine can reach it.
# SYNARA_DASHBOARD_HOST=127.0.0.1

# Port the dashboard listens on.
# SYNARA_DASHBOARD_PORT=8765

# Bearer token required to use the dashboard. Optional when bound to
# localhost. REQUIRED before any non-localhost host is allowed — the
# server refuses to start a write-capable console on the network
# without one. Keep it secret; it is never written to the logs.
# SYNARA_DASHBOARD_TOKEN=
